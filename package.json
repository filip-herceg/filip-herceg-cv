{
  "name": "filip-herceg-cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
  "test:ci": "vitest run --coverage --reporter=text",
  "coverage:report": "vitest run --coverage && echo 'Coverage OK'",
    "lhci": "lhci autorun || echo 'LH warnings ignored'",
    "test:a11y": "wait-on http://localhost:3000 && pa11y-ci",
    "build:budgets": "npm run build && node scripts/check-budgets.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
  "ci:quality": "npm run lint && npm run typecheck && npm run test:ci && npm run build:budgets",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
  "e2e:ui": "playwright test --ui",
  "release": "semantic-release"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "next": "14.2.31",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.17.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.47.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.31",
    "jsdom": "^26.1.0",
    "pa11y-ci": "^4.0.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.0.5",
    "wait-on": "^7.2.0"
  ,"semantic-release": "^24.0.0"
  ,"@semantic-release/changelog": "^6.0.3"
  ,"@semantic-release/git": "^10.0.1"
  ,"@semantic-release/commit-analyzer": "^13.0.0"
  ,"@semantic-release/release-notes-generator": "^14.0.0"
  ,"@semantic-release/github": "^10.0.5"
  }
}
