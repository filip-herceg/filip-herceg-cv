{
  "name": "filip-herceg-cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:visual:verify": "node scripts/verify-visual-baselines.mjs",
    "test:visual:variance": "node scripts/visual-variance.mjs",
    "test:visual:variance:summary": "node scripts/visual-variance-summary.mjs",
    "dev": "next dev",
  "build": "rimraf .next && next build && node scripts/subset-fonts.mjs",
    "start": "next start",
    "serve": "next start",
    "bench:pdf:run": "node scripts/benchmark-pdf-pool-run.mjs",
    "bench:pdf": "node scripts/benchmark-pdf-pool.mjs",
    "bench:trend": "node scripts/bench-trend.mjs",
    "bench:pdf:trend": "npm run bench:pdf:run && npm run bench:trend",
    "lint": "eslint . --no-cache",
    "lint:ci": "eslint . --no-cache --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:diag": "node scripts/lint-diagnostics.mjs",
    "lint:report": "node scripts/reports-ensure-dirs.mjs && eslint . -f json -o reports/lint/eslint-report.json || exit 0",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=text",
    "coverage:report": "vitest run --coverage && echo 'Coverage OK'",
    "lhci": "lhci autorun || echo 'LH warnings ignored'",
  "lhci:reports": "lhci autorun --collect.settings.chromePath=\"${CHROME_PATH:-C:/Program Files/Microsoft/Edge/Application/msedge.exe}\" --collect.url=http://localhost:3000/ --collect.url=http://localhost:3000/cv --collect.url=http://localhost:3000/projects --collect.url=http://localhost:3000/contact --upload.target=filesystem --upload.outputDir=reports/lighthouse || echo LHCI done",
  "test:a11y": "wait-on http://localhost:3000 && pa11y-ci",
  "test:a11y:report": "node scripts/reports-ensure-dirs.mjs && wait-on http://localhost:3000 && node scripts/pa11y-report.mjs",
  "build:budgets": "npm run build && node scripts/check-budgets.mjs",
  "fonts:subset": "node scripts/subset-fonts.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "docs:links": "node scripts/docs-link-check.mjs",
    "docs:index": "node scripts/docs-generate-index.mjs",
    "docs:index:reports": "node scripts/docs-write-index.mjs",
    "reports:ensure": "node scripts/reports-ensure-dirs.mjs",
    "reports:clean-root": "node scripts/clean-root-artifacts.mjs --delete",
    "docs:guard": "node scripts/docs-guard-legacy.mjs",
    "coverage:check": "node -e \"const fs=require('fs');const p=/All files[^0-9]*([0-9]+\\.?[0-9]*)/;const h=fs.readFileSync('coverage/lcov-report/index.html','utf8');const m=p.exec(h)||[];const pct=parseFloat(m[1]||'0');if(pct<90){console.error('Coverage below 90%:',pct);process.exit(1)}else{console.log('Coverage OK:',pct)}\"",
    "ci:quality": "npm run docs:guard && npm run lint:ci && npm run typecheck && npm run test:ci && npm run coverage:check && npm run build:budgets",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:raw": "playwright test",
    "e2e:auto": "node scripts/e2e-runner.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed:cv": "node scripts/seed-cv.mjs",
    "release": "semantic-release",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.52.1",
    "@opentelemetry/resources": "1.25.1",
    "@opentelemetry/sdk-trace-node": "1.25.1",
    "@opentelemetry/semantic-conventions": "1.25.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.541.0",
    "next": "15.5.0",
    "pdf-lib": "^1.17.1",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^24.17.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "redis": "^4.6.13",
    "resend": "^6.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.31",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "jsdom": "^26.1.0",
    "pa11y-ci": "^4.0.1",
    "pino": "^9.9.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "semantic-release": "^24.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
