##############################################
# Environment Variables (.env.example)
# Copy to .env and adjust values for local dev.
##############################################

# --- Database ---
# Provider is selected via PRISMA_DB_PROVIDER (postgresql | sqlite). If unset, tests default to sqlite.
# For sqlite (dev/tests) set DATABASE_URL="file:./dev.db" and leave PRISMA_DB_PROVIDER unset OR set to sqlite.
# For postgres (local/prod) set PRISMA_DB_PROVIDER=postgresql and supply DATABASE_URL & optional DATABASE_SHADOW_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/filip_cv?schema=public
DATABASE_SHADOW_URL=postgresql://user:password@localhost:5432/filip_cv_shadow?schema=public

# --- CV Storage Backend ---
# Options: db | redis | memory
CV_STORAGE=db
CV_AUTO_SEED=true

# --- Redis (optional distributed cache) ---
REDIS_URL=redis://localhost:6379
CV_REDIS_TTL=300

# --- S3 (optional object-store cache) ---
# Enable by setting CV_STORAGE=s3 and providing bucket & AWS creds (env / OIDC / IRSA etc.)
S3_BUCKET=
S3_PREFIX=cv
AWS_REGION=us-east-1


# --- Admin Bootstrap (only used if no user exists) ---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- PDF / Chromium ---
# Provide custom chromium path in container or prod if needed
CHROMIUM_PATH=/usr/bin/chromium

# --- Observability / Misc ---
ENABLE_TRACING=0
LOG_PRIVACY=low

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# --- Feature Flags (future) ---
# PLACEHOLDER_FEATURE=0

##############################################
# Notes:
# 1. For production, set secure secrets via your deployment platform (not committed .env).
# 2. After modifying the Prisma schema, generate a migration: npm run prisma:migrate:dev
# 3. Apply migrations in CI/CD: npm run prisma:migrate:deploy
##############################################
## Runtime Environment Example
# Base external URL used for absolute links in PDF rendering (fallback: request host)
BASE_URL=http://localhost:3000

# Path to Chromium/Chrome executable for puppeteer-core.
# If unset, the server will try common locations. If still not found, /api/cv/pdf returns 501.
CHROMIUM_PATH=

# (Optional) Additional puppeteer flags can be added via NODE_OPTIONS or custom patch if needed.
# Runtime Environment Variables
# Copy to .env.local (local dev) or supply via Kubernetes Secret / Helm values.

SITE_URL=https://yourdomain.tld
CONTACT_FROM_ADDRESS=portfolio@yourdomain.tld
CONTACT_TO_ADDRESS=you@yourdomain.tld
CONTACT_PROVIDER_API_KEY=changeme

# Feature flags (future)
FEATURE_ENABLE_RUM=true

# Persistence (dynamic CV)
# (Optional) SQLite dev database (reduced schema JSON unsupported) -> requires alternate schema file
# SQLITE_DATABASE_URL="file:./dev.db"

# Admin bootstrap password hash (bcrypt). If set and no admin user exists, system seeds admin account.
ADMIN_PASSWORD_HASH=
