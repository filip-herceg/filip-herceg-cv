## Runtime Environment Example
# Base external URL used for absolute links in PDF rendering (fallback: request host)
BASE_URL=http://localhost:3000

# Path to Chromium/Chrome executable for puppeteer-core.
# If unset, the server will try common locations. If still not found, /api/cv/pdf returns 501.
CHROMIUM_PATH=

# (Optional) Additional puppeteer flags can be added via NODE_OPTIONS or custom patch if needed.
# Runtime Environment Variables
# Copy to .env.local (local dev) or supply via Kubernetes Secret / Helm values.

SITE_URL=https://yourdomain.tld
CONTACT_FROM_ADDRESS=portfolio@yourdomain.tld
CONTACT_TO_ADDRESS=you@yourdomain.tld
CONTACT_PROVIDER_API_KEY=changeme

# Feature flags (future)
FEATURE_ENABLE_RUM=true

# Persistence (dynamic CV)
# SQLite dev database (file-based)
DATABASE_URL="file:./dev.db"

# (Optional) Postgres production example
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# Admin bootstrap password hash (bcrypt). If set and no admin user exists, system seeds admin account.
ADMIN_PASSWORD_HASH=
