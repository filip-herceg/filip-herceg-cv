// Prisma schema for dynamic CV persistence (Step 1)
// SQLite for development; can switch to PostgreSQL in production by datasource url.

// For local development & tests we default to sqlite (file:), can override to postgresql via env at runtime.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Core person info per locale (single row expected per locale)
model Person {
  id        String   @id @default(cuid())
  locale    String   @unique
  name      String
  title     String
  profile   String
  email     String
  location  String?
  phone     String?
  website   String?
  github    String?
  linkedin  String?
  twitter   String?
  linksJson String?  // JSON string array serialized
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String
  locale    String
  name      String
  category  String
  level     String?
  years     Int?
  tagsJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

model Project {
  id        String
  locale    String
  title     String
  role      String
  period    String
  company   String?
  summary   String
  highlightsJson Json?
  stackJson     Json?
  impact    String?
  linksJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

model Experience {
  id        String
  locale    String
  company   String
  role      String
  period    String
  location  String?
  employmentType String?
  summary   String?
  achievementsJson Json?
  stackJson     Json?
  tagsJson      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

model Education {
  id        String
  locale    String
  institution String
  degree     String
  field      String?
  period     String
  location   String?
  grade      String?
  summary    String?
  highlightsJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@id([id, locale])
}

model Certification {
  id        String
  locale    String
  name      String
  issuer    String
  year      Int?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

model Trait {
  id        String
  locale    String
  name      String
  description String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

model Hobby {
  id        String
  locale    String
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([id, locale])
}

// Export configuration (selective PDF presets)
model ExportConfig {
  id         String   @id @default(cuid())
  name       String   @unique
  presetType String?  @db.Text
  json       Json
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([presetType])
}

model Design {
  id        String   @id @default(cuid())
  locale    String   @unique
  pageJson      Json
  paletteJson   Json
  typographyJson Json
  shapesJson    Json
  sectionsJson  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meta {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}

// Administrative auth (single-user or small set). F17.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime  @default(now())
  @@index([userId])
}

// Share tokens for tokenized short links to exports
model ShareToken {
  id        String   @id @default(cuid())
  presetId  String
  scope     String   @default("latest_preset_export")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([presetId])
  @@index([expiresAt])
}
