# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
.eslintcache
verbose/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite test/dev databases (ephemeral)
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal

# Generated docs index (ephemeral, reproducible)
docs-index.json

# If you ever want to persist a dev DB under version control, override with a negation rule:
# !prisma/seed-data.db

# Reports and artifacts (centralized)
reports/
test-results/
pa11y-screenshots/
.lighthouseci/
playwright-report/
coverage-badge.json
.eslint_tmp.json
build-artifact.tgz

# Legacy types folder is deprecated; all declarations live under src/types
 # Only ignore the root-level types/ folder; allow src/types/
 /types/
